# ==============================================================================
# ClauseGuard Enterprise Git Configuration
# ==============================================================================

# --- Secrets & Environment Configurations ---
.env
.env.*
!.env.example
*.env

# --- Python Virtual Environments & Packages ---
.venv/
venv/
env/
ENV/
*.egg-info/
.installed.cfg
*.egg
dist/
build/
wheels/
__pypackages__/

# --- Byte-code & Runtime Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.manifest
*.spec

# --- Testing, Coverage & Linters ---
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml

# --- Frontend (Next.js & Node) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Data Pipelines & Staging ---
# Ignores raw bulk PDF uploads while keeping folder tracking intact
data/raw/*
!data/raw/.gitkeep
reports/

# --- Operating System & IDE Caches ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
tempCodeRunnerFile.py